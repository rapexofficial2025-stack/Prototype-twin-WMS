# Leave unset to run the 3D Digital Twin in demo mode (fake deterministic occupancy).
# Set this to point at the Django backend to load real inventory + ledger data live.
VITE_API_BASE_URL=http://localhost:8000

# Optional — only needed for live (no-poll) status pushes from Django. Digital
# Twin still works via plain API polling/refetch if these are left unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
