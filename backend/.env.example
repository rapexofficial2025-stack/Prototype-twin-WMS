# Supabase Postgres connection (Project Settings -> Database -> Connection string)
DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Leave both blank to run without live Firebase push (safe default).
# Firebase Admin SDK service account JSON (Project Settings -> Service accounts -> Generate key)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
