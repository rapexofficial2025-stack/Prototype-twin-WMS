# Supabase Postgres connection (Project Settings -> Database -> Connection string)
DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Firebase Admin SDK service account JSON (Project Settings -> Service accounts -> Generate key)
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

CORS_ALLOWED_ORIGINS=http://localhost:5173
